<Window x:Class="Rice2k.Encryption.BatchQueueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rice2k Batch Encryption Queue"
        Width="1100" Height="760"
        MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        AllowDrop="True"
        PreviewDragOver="Window_DragOver"
        Drop="Window_Drop">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Batch Encryption Queue" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Protect multiple files one at a time. A failure on one file does not remove successful encrypted outputs." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
            <TextBlock Text="Output files are saved beside each source file using safe Keep Both naming." Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="QueueCountText" Text="0 files in queue" FontWeight="SemiBold" FontSize="17" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="AddFilesButton" Content="Add files…" Click="AddFiles_Click" />
                        <Button x:Name="RemoveSelectedButton" Content="Remove selected" Click="RemoveSelected_Click" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button x:Name="ClearQueueButton" Content="Clear queue" Click="ClearQueue_Click" Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>
                </Grid>

                <DataGrid x:Name="BatchQueueGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Extended"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          Background="#0D1728"
                          Foreground="{StaticResource TextBrush}"
                          BorderBrush="{StaticResource BorderBrush}"
                          RowBackground="#0D1728"
                          AlternatingRowBackground="#111F35">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*" />
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="100" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1.3*" />
                        <DataGridTextColumn Header="Progress" Binding="{Binding Progress, StringFormat={}{0:0}%}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Protection" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Recommended: XChaCha20-Poly1305 + Argon2id" Foreground="{StaticResource SuccessBrush}" FontSize="12" Margin="0,5,0,10" />
                    <Label Content="Password" />
                    <PasswordBox x:Name="BatchPasswordBox" PasswordChanged="BatchPassword_Changed" />
                    <Label Content="Confirm password" Margin="0,8,0,0" />
                    <PasswordBox x:Name="BatchConfirmPasswordBox" PasswordChanged="BatchPassword_Changed" />
                    <TextBlock x:Name="BatchPasswordStatusText" Text="Enter at least 12 characters" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,5,0,0" />
                    <Button Content="Generate strong password" Click="GeneratePassword_Click" Style="{StaticResource SecondaryButtonStyle}" Width="190" HorizontalAlignment="Left" Margin="0,9,0,0" />
                    <CheckBox x:Name="BatchVerifyCheck" Content="Verify each encrypted file before finalizing" IsChecked="True" Foreground="{StaticResource TextBrush}" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Queue status" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="BatchStatusText" Text="Ready" FontWeight="SemiBold" Margin="0,12,0,3" />
                    <ProgressBar x:Name="BatchOverallProgress" Minimum="0" Maximum="100" Value="0" Margin="0,7,0,5" />
                    <TextBlock x:Name="BatchProgressDetails" Text="Add files to begin." Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" />
                    <Border Background="#0D1728" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,14,0,0">
                        <TextBlock Text="Rice2k processes files sequentially so status and failures stay easy to understand. Completed outputs remain intact if a later item fails or the queue is cancelled." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Tip: drag more files onto this window to add them to the queue." Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" FontSize="12" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CancelBatchButton" Content="Cancel safely" Click="CancelBatch_Click" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}" />
                <Button x:Name="StartBatchButton" Content="🔒 Start batch" Click="StartBatch_Click" MinWidth="145" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
