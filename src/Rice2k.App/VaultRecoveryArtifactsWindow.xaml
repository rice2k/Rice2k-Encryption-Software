<Window x:Class="Rice2k.Encryption.VaultRecoveryArtifactsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rice2k Vault Recovery Files"
        Width="920" Height="560"
        MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Vault Recovery Files" FontSize="27" FontWeight="SemiBold" />
            <TextBlock Text="Review preserved backup and interrupted pending-save files without guessing which copy is safe." Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DataGrid x:Name="ArtifactsGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          Background="#0D1728"
                          Foreground="{StaticResource TextBrush}"
                          BorderBrush="{StaticResource BorderBrush}"
                          RowBackground="#0D1728"
                          AlternatingRowBackground="#111F35">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="180" />
                        <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*" />
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="110" />
                        <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedDisplay}" Width="165" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="1" Background="#0A1423" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock x:Name="StatusText" Text="Select a recovery file to inspect it." FontWeight="SemiBold" />
                        <TextBlock x:Name="DetailText" Text="Pending files are never promoted automatically. Verify them first, then move them aside if you want to preserve them for manual recovery." Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="CountText" Text="0 recovery files" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Refresh" Click="Refresh_Click" Style="{StaticResource SecondaryButtonStyle}" />
                <Button Content="Verify Selected" Click="VerifySelected_Click" Style="{StaticResource SecondaryButtonStyle}" />
                <Button Content="Move Pending Aside…" Click="MovePendingAside_Click" MinWidth="165" />
                <Button Content="Close" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
