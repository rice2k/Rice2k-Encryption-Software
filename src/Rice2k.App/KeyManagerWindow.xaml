<Window x:Class="Rice2k.Encryption.KeyManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rice2k Key Manager"
        Width="1080" Height="760"
        MinWidth="900" MinHeight="650"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Key Manager" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Create 256-bit encryption keys and protect exported key packages with a password." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
            <TextBlock Text="Keys in this development build remain in memory only unless you export an encrypted .r2kkey package." Foreground="{StaticResource WarningBrush}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Create a new key" FontSize="18" FontWeight="SemiBold" />
                    <Label Content="Key name" Margin="0,10,0,0" />
                    <TextBox x:Name="KeyNameBox" Text="My Encryption Key" MaxLength="80" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="18,0,0,0">
                    <Button Content="Generate 256-bit key" Click="GenerateKey_Click" MinWidth="170" />
                    <Button Content="Import .r2kkey…" Click="ImportKey_Click" Style="{StaticResource SecondaryButtonStyle}" MinWidth="150" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.55*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="KeyCountText" Text="Session keys" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <DataGrid x:Name="KeysGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionChanged="KeysGrid_SelectionChanged"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Background="#0D1728"
                              Foreground="{StaticResource TextBrush}"
                              BorderBrush="{StaticResource BorderBrush}"
                              RowBackground="#0D1728"
                              AlternatingRowBackground="#111F35">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.3*" />
                            <DataGridTextColumn Header="Fingerprint" Binding="{Binding Fingerprint}" Width="2*" />
                            <DataGridTextColumn Header="Created" Binding="{Binding CreatedDisplay}" Width="125" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Selected key" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="SelectedKeyNameText" Text="No key selected" FontWeight="SemiBold" Margin="0,13,0,3" TextWrapping="Wrap" />
                    <TextBlock x:Name="SelectedKeyTypeText" Text="Select a key to view its safe identifying details." Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" />

                    <Label Content="Fingerprint" Margin="0,14,0,0" />
                    <TextBox x:Name="SelectedFingerprintBox" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap" />
                    <TextBlock Text="The fingerprint identifies the key without revealing the secret key bytes." Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" />

                    <Separator Margin="0,16" Background="{StaticResource BorderBrush}" />
                    <TextBlock Text="Encrypted key package" FontWeight="SemiBold" />
                    <TextBlock Text="Use a separate strong password to protect exported .r2kkey files." Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,4,0,8" TextWrapping="Wrap" />
                    <Label Content="Package password" />
                    <PasswordBox x:Name="PackagePasswordBox" />
                    <Label Content="Confirm password (required for export)" Margin="0,8,0,0" />
                    <PasswordBox x:Name="PackageConfirmPasswordBox" />

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="ExportKeyButton" Content="Export selected…" Click="ExportKey_Click" IsEnabled="False" />
                        <Button x:Name="RemoveKeyButton" Content="Remove from session" Click="RemoveKey_Click" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#0D1728" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,14,0,0">
            <TextBlock x:Name="KeyManagerStatusText" Text="Ready. Secret key material is never shown in the interface." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
