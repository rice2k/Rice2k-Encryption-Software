<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Rice2kEncryption</AssemblyName>
    <RootNamespace>Rice2k.Encryption</RootNamespace>
    <ApplicationIcon Condition="Exists('Assets\\Rice2k.ico')">Assets\Rice2k.ico</ApplicationIcon>
    <Version>0.6.0-preview.4</Version>
    <Authors>Christopher Schumacher / Rice2k</Authors>
    <Product>Rice2k Encryption Software</Product>
    <Description>Modern, user-friendly Windows encryption software.</Description>
    <Copyright>Copyright © 2026 Christopher Schumacher / Rice2k</Copyright>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Rice2k is a WPF app. WinForms is enabled only for the tray/balloon
       notification bridge, whose types are fully qualified in source. Avoid
       importing WinForms/Drawing globally so WPF names such as Application,
       Clipboard, Color, Point, and Size cannot become ambiguous. -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Sodium.Core" Version="1.4.1" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.0" />
  </ItemGroup>

</Project>
