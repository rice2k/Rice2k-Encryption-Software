<Window x:Class="Rice2k.Encryption.WelcomeTourWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Rice2k Encryption Software"
        Width="720" Height="500"
        MinWidth="650" MinHeight="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="RICE2K ENCRYPTION SOFTWARE" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" FontSize="13" />
            <TextBlock x:Name="TourTitleText" Text="Welcome to Rice2k" FontSize="30" FontWeight="SemiBold" Margin="0,5,0,0" />
            <TextBlock x:Name="TourProgressText" Text="1 of 5" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,6,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,20,0,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="TourHeadlineText" Text="Protect files without learning cryptography first" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="TourBodyText" Grid.Row="1" TextWrapping="Wrap" FontSize="15" LineHeight="23" Margin="0,14,0,14" />

                <Border Grid.Row="2" Background="#0D1728" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Helpful tip" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                        <TextBlock x:Name="TourTipText" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="SkipButton" Content="Skip tour" Click="Skip_Click" Style="{StaticResource SecondaryButtonStyle}" MinWidth="100" />

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="BackButton" Content="← Back" Click="Back_Click" Style="{StaticResource SecondaryButtonStyle}" MinWidth="100" />
                <Button x:Name="NextButton" Content="Next →" Click="Next_Click" MinWidth="110" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
