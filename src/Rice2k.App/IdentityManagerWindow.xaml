<Window x:Class="Rice2k.Encryption.IdentityManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rice2k Identity Manager"
        Width="980" Height="680"
        MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Closing="Window_Closing">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Identity Manager" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="Create encryption/signing identities and export only the material you intend to share. Private keys stay hidden in the normal interface."
                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Create identity" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="The name is a label only. Trust comes from comparing the fingerprint through an independent channel."
                               Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,5,0,10" />
                    <TextBox x:Name="IdentityNameBox" MaxLength="200" ToolTip="Display label for this identity" AutomationProperties.Name="Identity display name" />
                </StackPanel>
                <Button Grid.Column="1" Content="Generate Identity" Click="GenerateIdentity_Click" MinWidth="155" Height="42" Margin="12,28,0,0" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ListView x:Name="IdentityList" SelectionMode="Single" AutomationProperties.Name="Loaded private identities">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="190" />
                            <GridViewColumn Header="Fingerprint" DisplayMemberBinding="{Binding Fingerprint}" Width="390" />
                            <GridViewColumn Header="Created" DisplayMemberBinding="{Binding CreatedDisplay}" Width="165" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <WrapPanel Grid.Row="1" Margin="0,14,0,0">
                    <Button Content="Import Private…" Click="ImportPrivate_Click" />
                    <Button Content="Export Private…" Click="ExportPrivate_Click" Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Content="Export Public…" Click="ExportPublic_Click" Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Content="Copy Fingerprint" Click="CopyFingerprint_Click" Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Content="Remove" Click="RemoveIdentity_Click" Style="{StaticResource SecondaryButtonStyle}" />
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="StatusText" Text="No private identities loaded in this session." FontWeight="SemiBold" />
                <TextBlock Text=".r2kid = encrypted private identity • .r2kpub = shareable public identity card"
                           Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,3,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Close" Click="Close_Click" Style="{StaticResource SecondaryButtonStyle}" Width="95" />
        </Grid>
    </Grid>
</Window>
