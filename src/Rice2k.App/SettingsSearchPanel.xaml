<UserControl x:Class="Rice2k.Encryption.SettingsSearchPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="Find a setting" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="Search by words such as hints, tour, simple, verify, privacy, clipboard, lock, history, motion, or advanced." Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,4,0,10" />
                <TextBox x:Name="SettingsSearchBox" TextChanged="SettingsSearchBox_TextChanged" ToolTip="Search Rice2k settings" />
                <TextBlock x:Name="SearchStatusText" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <Border x:Name="ExperienceCard" Style="{StaticResource CardStyle}" Tag="hints helpful guidance tour welcome onboarding beginner simple interface accessibility motion animation reduce motion">
            <StackPanel>
                <TextBlock Text="Guidance &amp; interface" FontSize="18" FontWeight="SemiBold" />
                <CheckBox x:Name="HelpfulHintsCheck"
                          Content="Show helpful hints and contextual tips"
                          Checked="HelpfulHints_Changed"
                          Unchecked="HelpfulHints_Changed"
                          Foreground="{StaticResource TextBrush}"
                          Margin="0,12,0,5" />
                <TextBlock Text="Hints explain what actions do without exposing unnecessary cryptographic terminology." Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" />
                <CheckBox x:Name="ReduceMotionCheck"
                          Content="Reduce motion and avoid nonessential indeterminate animation"
                          Checked="ReduceMotion_Changed"
                          Unchecked="ReduceMotion_Changed"
                          Foreground="{StaticResource TextBrush}"
                          Margin="0,12,0,5" />
                <TextBlock Text="Rice2k will prefer static progress/status presentation where it controls animation. This preference does not override Windows accessibility settings." Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" />
                <Button Content="Replay welcome tour" Click="ReplayTour_Click" Width="170" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}" Margin="0,12,0,0" />
                <TextBlock x:Name="PreferenceStatusText" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <Border x:Name="ModeCard" Style="{StaticResource CardStyle}" Tag="simple advanced interface mode cryptography technical settings">
            <StackPanel>
                <TextBlock Text="Interface mode" FontSize="18" FontWeight="SemiBold" />
                <RadioButton Content="Simple — recommended for most users" IsChecked="True" Foreground="{StaticResource TextBrush}" Margin="0,12,0,5" />
                <RadioButton Content="Advanced — cryptographic and format controls (planned)" IsEnabled="False" Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock Text="Simple Mode keeps recommended security selected automatically. Advanced Mode will not be enabled until its controls and compatibility rules are fully tested." Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <Border x:Name="SafetyCard" Style="{StaticResource CardStyle}" Tag="verify verification source overwrite keep both safety original cancel pause progress">
            <StackPanel>
                <TextBlock Text="File safety" FontSize="18" FontWeight="SemiBold" />
                <CheckBox Content="Verify encrypted files before finalizing (recommended default)" IsChecked="True" IsEnabled="False" Foreground="{StaticResource TextBrush}" Margin="0,12,0,5" />
                <TextBlock Text="Rice2k keeps source files, refuses automatic overwrites, uses temporary outputs, and verifies encrypted files by default. These safety defaults are intentionally not weakened by Simple Mode." Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border x:Name="PrivacyCard" Style="{StaticResource CardStyle}" Tag="privacy clipboard clear app lock password minimize windows session inactivity auto lock history filenames previews recent files persistent activity local offline">
            <StackPanel>
                <TextBlock Text="Privacy controls" FontSize="18" FontWeight="SemiBold" />
                <CheckBox x:Name="PrivacyModeCheck"
                          Content="Privacy Mode — hide session activity and clear transient sensitive previews"
                          Checked="PrivacyPreference_Changed"
                          Unchecked="PrivacyPreference_Changed"
                          Foreground="{StaticResource TextBrush}"
                          Margin="0,12,0,5" />
                <TextBlock Text="Privacy Mode does not change your encrypted files. It reduces sensitive information visible in the running interface." Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" />

                <CheckBox x:Name="HideActivityCheck"
                          Content="Hide and clear Activity entries while Privacy Mode is on"
                          Checked="PrivacyPreference_Changed"
                          Unchecked="PrivacyPreference_Changed"
                          Foreground="{StaticResource TextBrush}"
                          Margin="0,12,0,4" />
                <CheckBox x:Name="ClearPreviewsCheck"
                          Content="Clear text/password previews when Privacy Mode turns on"
                          Checked="PrivacyPreference_Changed"
                          Unchecked="PrivacyPreference_Changed"
                          Foreground="{StaticResource TextBrush}" />
                <CheckBox x:Name="ClearDiskHistoryCheck"
                          Content="Clear optional recent-file and persistent activity history when Privacy Mode turns on"
                          Checked="PrivacyPreference_Changed"
                          Unchecked="PrivacyPreference_Changed"
                          Foreground="{StaticResource TextBrush}"
                          Margin="0,4,0,0" />

                <TextBlock Text="Optional local history" FontWeight="SemiBold" Margin="0,16,0,5" />
                <CheckBox x:Name="RememberRecentFilesCheck"
                          Content="Remember recent files on this Windows account"
                          Checked="PrivacyPreference_Changed"
                          Unchecked="PrivacyPreference_Changed"
                          Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="Off by default. When enabled, recent-file history stores full local paths so you can recognize files later." Foreground="{StaticResource WarningBrush}" FontSize="12" TextWrapping="Wrap" Margin="20,3,0,7" />
                <CheckBox x:Name="PersistentActivityCheck"
                          Content="Save a persistent redacted activity log"
                          Checked="PrivacyPreference_Changed"
                          Unchecked="PrivacyPreference_Changed"
                          Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="Off by default. Persistent activity stores only action names and timestamps. Rice2k excludes filenames, paths, plaintext, passwords, keys, and recovery secrets from this log." Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="20,3,0,8" />
                <Button Content="Review / clear stored history…" Click="ReviewStoredHistory_Click" Style="{StaticResource SecondaryButtonStyle}" Width="220" HorizontalAlignment="Left" />

                <TextBlock Text="Clipboard auto-clear" FontWeight="SemiBold" Margin="0,16,0,5" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <ComboBox x:Name="ClipboardSecondsCombo" SelectionChanged="ClipboardSeconds_Changed" ToolTip="How long Rice2k-owned clipboard values remain before automatic clearing">
                        <ComboBoxItem Content="Never" Tag="0" />
                        <ComboBoxItem Content="15 seconds" Tag="15" />
                        <ComboBoxItem Content="30 seconds" Tag="30" />
                        <ComboBoxItem Content="1 minute" Tag="60" />
                        <ComboBoxItem Content="2 minutes" Tag="120" />
                    </ComboBox>
                    <Button Grid.Column="1" Content="Clear Clipboard Now" Click="ClearClipboardNow_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" MinWidth="160" />
                </Grid>
                <TextBlock Text="Auto-clear only removes a value if the clipboard still contains the exact value Rice2k copied. It will not intentionally erase something you copied afterward in another application." Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />

                <Separator Margin="0,18,0,14" />
                <TextBlock Text="Authenticated App Lock" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="App Lock hides Rice2k behind a password screen. Once configured, Rice2k also starts locked. The app-lock password is independent from file, vault, key-package, and identity passwords."
                           Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,10" />
                <TextBlock x:Name="AppLockConfiguredText" Text="App Lock is not configured." FontWeight="SemiBold" Margin="0,0,0,8" />
                <WrapPanel>
                    <Button x:Name="ConfigureAppLockButton" Content="Set App Lock Password…" Click="ConfigureAppLock_Click" MinWidth="180" />
                    <Button x:Name="RemoveAppLockButton" Content="Remove App Lock…" Click="RemoveAppLock_Click" Style="{StaticResource SecondaryButtonStyle}" MinWidth="150" IsEnabled="False" />
                </WrapPanel>

                <CheckBox x:Name="LockOnMinimizeCheck"
                          Content="Lock when the main Rice2k window is minimized"
                          Checked="AppLockPreference_Changed"
                          Unchecked="AppLockPreference_Changed"
                          Foreground="{StaticResource TextBrush}"
                          Margin="0,14,0,4" />
                <CheckBox x:Name="LockOnWindowsSessionCheck"
                          Content="Lock when Windows reports the current session is locked"
                          Checked="AppLockPreference_Changed"
                          Unchecked="AppLockPreference_Changed"
                          Foreground="{StaticResource TextBrush}" />

                <TextBlock Text="Lock after no Rice2k input" FontWeight="SemiBold" Margin="0,14,0,5" />
                <ComboBox x:Name="AppLockInactivityCombo" Width="220" HorizontalAlignment="Left" SelectionChanged="AppLockInactivity_Changed">
                    <ComboBoxItem Content="Never" Tag="0" />
                    <ComboBoxItem Content="1 minute" Tag="1" />
                    <ComboBoxItem Content="5 minutes" Tag="5" />
                    <ComboBoxItem Content="10 minutes" Tag="10" />
                    <ComboBoxItem Content="15 minutes" Tag="15" />
                    <ComboBoxItem Content="30 minutes" Tag="30" />
                </ComboBox>
                <TextBlock Text="App Lock is a local privacy barrier. Someone who already controls your Windows account or can modify Rice2k's local files is outside this feature's security boundary."
                           Foreground="{StaticResource WarningBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />

                <TextBlock x:Name="PrivacyStatusText" Text="Session activity remains in-memory unless you explicitly enable redacted persistent logging. Rice2k operates locally/offline by design." Foreground="{StaticResource SuccessBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
